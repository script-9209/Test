				local draggingSlider = false
				local function updateSlider(input)
					local pos = math.clamp((input.Position.X - SliderBar.AbsolutePosition.X) / SliderBar.AbsoluteSize.X, 0, 1)
					local rawVal = min + ((max - min) * pos)
					val = math.floor(math.round(rawVal / increment) * increment * 1000) / 1000
					val = math.clamp(val, min, max)
					
					ExodusHub.Flags[flag] = val
					Fill.Size = UDim2.new((val - min) / (max - min), 0, 1, 0)
					Label.Text = name .. ": " .. tostring(val)
					ExodusHub:SaveConfiguration()
					callback(val)
				end

				SliderBar.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
						draggingSlider = true
						updateSlider(input)
					end
				end)
				UserInputService.InputEnded:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
						draggingSlider = false
					end
				end)
				UserInputService.InputChanged:Connect(function(input)
					if draggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
						updateSlider(input)
					end
				end)
			end

			function Section:CreateInput(Config)
				Config = Config or {}
				local nameText = Config.Name or "Text Box"
				local flag = Config.Flag or nameText
				local placeholder = Config.PlaceholderText or "Type here..."
				local callback = Config.Callback or function() end

				local initialText = ExodusHub.Flags[flag] ~= nil and tostring(ExodusHub.Flags[flag]) or ""

				local Container = Instance.new("Frame")
				Container.Size = UDim2.new(1, 0, 0, 42)
				Container.ZIndex = 6
				Container.Parent = ItemsContainer
				apply3DEffect(Container, Color3.fromRGB(30, 30, 30), Color3.fromRGB(60, 60, 60), Color3.fromRGB(15, 15, 15), 2)

				local Label = Instance.new("TextLabel")
				Label.Size = UDim2.new(0.48, -10, 0, 20)
				Label.Position = UDim2.new(0, 10, 0, 11)
				Label.BackgroundTransparency = 1
				Label.Text = nameText
				Label.TextColor3 = Color3.fromRGB(255, 255, 255)
				Label.Font = Enum.Font.FredokaOne
				Label.TextSize = 14
				Label.TextXAlignment = Enum.TextXAlignment.Left
				Label.TextYAlignment = Enum.TextYAlignment.Top
				Label.TextWrapped = true
				Label.ZIndex = 7
				Label.Parent = Container

				local BoxFrame = Instance.new("Frame")
				BoxFrame.Size = UDim2.new(0.48, -10, 0, 28)
				BoxFrame.Position = UDim2.new(0.5, 2, 0, 7)
				BoxFrame.ZIndex = 7
				BoxFrame.Parent = Container
				apply3DEffect(BoxFrame, Color3.fromRGB(15, 15, 15), Color3.fromRGB(40, 40, 40), Color3.fromRGB(0, 0, 0), 1)

				local InputBox = Instance.new("TextBox")
				InputBox.Size = UDim2.new(1, -12, 1, 0)
				InputBox.Position = UDim2.new(0, 6, 0, 0)
				InputBox.BackgroundTransparency = 1
				InputBox.Text = initialText
				InputBox.PlaceholderText = placeholder
				InputBox.PlaceholderColor3 = Color3.fromRGB(130, 130, 130)
				InputBox.TextColor3 = Color3.fromRGB(255, 255, 255)
				InputBox.Font = Enum.Font.SourceSans
				InputBox.TextSize = 14
				InputBox.TextXAlignment = Enum.TextXAlignment.Left
				InputBox.ClipsDescendants = true
				InputBox.TextTruncate = Enum.TextTruncate.AtEnd
				InputBox.ZIndex = 8
				InputBox.Parent = BoxFrame

				Label:GetPropertyChangedSignal("TextBounds"):Connect(function()
					local requiredLabelHeight = Label.TextBounds.Y
					local totalHeight = math.max(42, requiredLabelHeight + 20)
					Container.Size = UDim2.new(1, 0, 0, totalHeight)
					Label.Size = UDim2.new(0.48, -10, 0, requiredLabelHeight)
					BoxFrame.Position = UDim2.new(0.5, 2, 0.5, -14)
				end)

				InputBox.FocusLost:Connect(function(enterPressed)
					ExodusHub.Flags[flag] = InputBox.Text
					ExodusHub:SaveConfiguration()
					callback(InputBox.Text, enterPressed)
				end)
			end
			
			function Section:CreateTextBox(Config)
				return self:CreateInput(Config)
			end

			function Section:CreateDropdown(Config)
				Config = Config or {}
				local name = Config.Name or "Dropdown"
				local flag = Config.Flag or name
				local options = Config.Options or {}
				local current = Config.CurrentOption
				
				local selected = ExodusHub.Flags[flag] ~= nil and ExodusHub.Flags[flag] or (type(current) == "table" and current[1] or current or options[1])
				ExodusHub.Flags[flag] = selected
				local callback = Config.Callback or function() end
				local isOpen = false

				local DropFrame = Instance.new("Frame")
				DropFrame.Size = UDim2.new(1, 0, 0, 38)
				DropFrame.ClipsDescendants = true
				DropFrame.ZIndex = 15
				DropFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
				DropFrame.BorderSizePixel = 0
				DropFrame.Parent = ItemsContainer

				apply3DEffect(DropFrame, Color3.fromRGB(30, 30, 30), Color3.fromRGB(60, 60, 60), Color3.fromRGB(15, 15, 15), 2)

				local HeaderBtn = Instance.new("TextButton")
				HeaderBtn.Size = UDim2.new(1, 0, 0, 38)
				HeaderBtn.BackgroundTransparency = 1
				HeaderBtn.Text = "  " .. name .. ": " .. tostring(selected)
				HeaderBtn.Font = Enum.Font.FredokaOne
				HeaderBtn.TextSize = 14
				HeaderBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
				HeaderBtn.TextXAlignment = Enum.TextXAlignment.Left
				HeaderBtn.ZIndex = 16
				HeaderBtn.Parent = DropFrame

				local OptionList = Instance.new("Frame")
				OptionList.Size = UDim2.new(1, -12, 0, 0)
				OptionList.Position = UDim2.new(0, 6, 0, 42)
				OptionList.BackgroundTransparency = 1
				OptionList.ZIndex = 16
				OptionList.Parent = DropFrame

				local dropdownObj = {}
				function dropdownObj:Refresh(newOptions, newCurrent)
					options = newOptions or {}
					selected = ExodusHub.Flags[flag] ~= nil and ExodusHub.Flags[flag] or (type(newCurrent) == "table" and newCurrent[1] or newCurrent or options[1])
					HeaderBtn.Text = "  " .. name .. ": " .. tostring(selected)
					
					OptionList:ClearAllChildren()
					local Grid = Instance.new("UIGridLayout")
					Grid.CellSize = UDim2.new(0.5, -4, 0, 32)
					Grid.CellPadding = UDim2.new(0, 8, 0, 6)
					Grid.Parent = OptionList

					local rowsCount = math.ceil(#options / 2)
					OptionList.Size = UDim2.new(1, -12, 0, rowsCount * 36 + ((rowsCount - 1) * 6))

					for _, opt in ipairs(options) do
						local OptBtn = Instance.new("TextButton")
						OptBtn.Size = UDim2.new(1, 0, 1, 0)
						OptBtn.Text = "  " .. opt
						OptBtn.Font = Enum.Font.SourceSansBold
						OptBtn.TextSize = 14
						OptBtn.TextColor3 = Color3.fromRGB(240, 240, 240)
						OptBtn.AutoButtonColor = false
						OptBtn.ZIndex = 17
						OptBtn.Parent = OptionList
						
						apply3DEffect(OptBtn, Color3.fromRGB(45, 45, 45), Color3.fromRGB(80, 80, 80), Color3.fromRGB(20, 20, 20), 1)

						local RedMark = Instance.new("Frame")
						RedMark.Name = "RedMark"
						RedMark.Size = UDim2.new(0, 8, 0, 16)
						RedMark.Position = UDim2.new(1, -14, 0.5, -8)
						RedMark.BackgroundColor3 = Color3.fromRGB(220, 20, 20)
						RedMark.BorderSizePixel = 0
						RedMark.Visible = (opt == selected)
						RedMark.ZIndex = 18
						RedMark.Parent = OptBtn

						OptBtn.Activated:Connect(function()
							selected = opt
							ExodusHub.Flags[flag] = selected
							HeaderBtn.Text = "  " .. name .. ": " .. selected
							isOpen = false
							DropFrame.Size = UDim2.new(1, 0, 0, 38)
							ExodusHub:SaveConfiguration()
							callback({selected})
						end)
					end
				end

				dropdownObj:Refresh(options, selected)

				HeaderBtn.Activated:Connect(function()
					isOpen = not isOpen
					if isOpen then
						DropFrame.Size = UDim2.new(1, 0, 0, 48 + OptionList.AbsoluteSize.Y)
					else
						DropFrame.Size = UDim2.new(1, 0, 0, 38)
					end
				end)

				return dropdownObj
			end

			function Section:CreateParagraph(Config)
				Config = Config or {}
				local container = Instance.new("Frame")
				container.Size = UDim2.new(1, 0, 0, 70)
				container.AutomaticSize = Enum.AutomaticSize.Y
				container.ZIndex = 6
				container.Parent = ItemsContainer

				apply3DEffect(container, Color3.fromRGB(30, 30, 30), Color3.fromRGB(60, 60, 60), Color3.fromRGB(15, 15, 15), 2)

				local titleLabel = Instance.new("TextLabel")
				titleLabel.Size = UDim2.new(1, -20, 0, 24)
				titleLabel.Position = UDim2.new(0, 10, 0, 6)
				titleLabel.BackgroundTransparency = 1
				titleLabel.Text = Config.Title or ""
				titleLabel.Font = Enum.Font.FredokaOne
				titleLabel.TextSize = 14
				titleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
				titleLabel.TextXAlignment = Enum.TextXAlignment.Left
				titleLabel.ZIndex = 7
				titleLabel.Parent = container

				local contentLabel = Instance.new("TextLabel")
				contentLabel.Size = UDim2.new(1, -20, 0, 36)
				contentLabel.Position = UDim2.new(0, 10, 0, 28)
				contentLabel.BackgroundTransparency = 1
				contentLabel.Text = Config.Content or ""
				contentLabel.Font = Enum.Font.SourceSans
				contentLabel.TextSize = 13
				contentLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
				contentLabel.TextXAlignment = Enum.TextXAlignment.Left
				contentLabel.TextYAlignment = Enum.TextYAlignment.Top
				contentLabel.TextWrapped = true
				contentLabel.ZIndex = 7
				contentLabel.Parent = container

				contentLabel:GetPropertyChangedSignal("TextBounds"):Connect(function()
					contentLabel.Size = UDim2.new(1, -20, 0, contentLabel.TextBounds.Y + 4)
					container.Size = UDim2.new(1, 0, 0, contentLabel.TextBounds.Y + 38)
				end)

				local paragraphObj = {}
				function paragraphObj:Set(newConfig)
					if newConfig.Title then titleLabel.Text = newConfig.Title end
					if newConfig.Content then contentLabel.Text = newConfig.Content end
				end
				return paragraphObj
			end

			return Section
		end

		table.insert(Window.Tabs, Tab)
		return Tab
	end

	return Window
end

return ExodusHub
