	Callback = function(val)
		local sg = ParentGui:FindFirstChild("ExodusHubUI")
		if sg then
			local main = sg:FindFirstChild("ExodusHubMain")
			if main then
				local scale = main:FindFirstChildOfClass("UIScale")
				if not scale then
					scale = Instance.new("UIScale")
					scale.Parent = main
				end
				scale.Scale = (val / 100) * (ExodusHub.BaseScale or 1)
			end
		end
	end
})

