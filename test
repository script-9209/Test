				ValueBottomLight.BackgroundColor3 = Color3.fromRGB(55, 55, 55)
				ValueBottomLight.BorderSizePixel = 0
				ValueBottomLight.ZIndex = 9
				ValueBottomLight.Parent = ValueBox

				local ValueRightLight = Instance.new("Frame")
				ValueRightLight.Size = UDim2.new(0, 2, 1, 0)
				ValueRightLight.Position = UDim2.new(1, -2, 0, 0)
