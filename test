				ValueRightLight.BorderSizePixel = 0
				ValueRightLight.ZIndex = 9
				ValueRightLight.Parent = ValueBox

				local ValueOuterStroke = Instance.new("UIStroke")
				ValueOuterStroke.Color = Color3.fromRGB(0, 0, 0)
				ValueOuterStroke.Thickness = 1
				ValueOuterStroke.Parent = ValueBox

				local SliderBar = Instance.new("TextButton")
				SliderBar.Size = UDim2.new(1, -24, 0, 10)
				SliderBar.Position = UDim2.new(0, 12, 0, 32)
				SliderBar.Text = ""
				SliderBar.AutoButtonColor = false
				SliderBar.ZIndex = 7
				SliderBar.Parent = Frame
				apply3DEffect(SliderBar, Color3.fromRGB(20, 20, 20), Color3.fromRGB(50, 50, 50), Color3.fromRGB(5, 5, 5), 1)

				local Fill = Instance.new("Frame")
				Fill.Size = UDim2.new((val - min) / (max - min), 0, 1, 0)
				local t = ExodusHub.Themes[ExodusHub.CurrentTheme]
				Fill.BackgroundColor3 = t.Primary
				Fill.BorderSizePixel = 0
				Fill.ZIndex = 8
				Fill.Parent = SliderBar

				local WhiteKnob = Instance.new("Frame")
				WhiteKnob.Size = UDim2.new(0, 8, 0, 20)
				WhiteKnob.Position = UDim2.new(1, -4, 0.5, -10)
				WhiteKnob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
				WhiteKnob.BorderSizePixel = 0
				WhiteKnob.ZIndex = 9
				WhiteKnob.Parent = Fill

				ValueBox.FocusLost:Connect(function()
					local num = tonumber(ValueBox.Text)
					if num then
						num = math.clamp(math.floor(math.round(num / increment) * increment * 1000) / 1000, min, max)
						val = num
						ExodusHub.Flags[flag] = val
						Fill.Size = UDim2.new((val - min) / (max - min), 0, 1, 0)
						Label.Text = name .. ": " .. tostring(val) .. suffix
						ExodusHub:SaveConfiguration()
						callback(val)
					else
						ValueBox.Text = tostring(val)
					end
				end)

				local draggingSlider = false
				local function updateSlider(input)
					local pos = math.clamp((input.Position.X - SliderBar.AbsolutePosition.X) / SliderBar.AbsoluteSize.X, 0, 1)
					local rawVal = min + ((max - min) * pos)
					val = math.floor(math.round(rawVal / increment) * increment * 1000) / 1000
					val = math.clamp(val, min, max)

					ExodusHub.Flags[flag] = val
					Fill.Size = UDim2.new((val - min) / (max - min), 0, 1, 0)
					Label.Text = name .. ": " .. tostring(val) .. suffix
					ValueBox.Text = tostring(val)
					ExodusHub:SaveConfiguration()
					callback(val)
				end

				SliderBar.InputBegan:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
						draggingSlider = true
						updateSlider(input)
					end
				end)
				UserInputService.InputEnded:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
						draggingSlider = false
					end
				end)
				UserInputService.InputChanged:Connect(function(input)
					if draggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
						updateSlider(input)
					end
				end)
			end

