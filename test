	local function applySearchFilter(query)
		query = string.lower(tostring(query or ""))
		for _, section in pairs(SearchIndex) do
			local sectionMatch = #query == 0 or (string.find(section.Title, query, 1, true) ~= nil)
			local anyItemVisible = #query == 0
			for _, item in pairs(section.Items) do
				local show = #query == 0 or sectionMatch or (string.find(item.Text, query, 1, true) ~= nil)
				if item.Frame and item.Frame.Parent then
					item.Frame.Visible = show
				end
				if show then anyItemVisible = true end
			end
			local showSection = #query == 0 or sectionMatch or anyItemVisible
			section.Header.Visible = showSection
			section.Container.Visible = showSection
		end
	end

