-- 2. Farm Tab
local FarmTab = Window:CreateTab("Farm")
local AutoFarmSection = FarmTab:CreateSection("Auto Farming")
AutoFarmSection:CreateToggle({
	Name = "Auto Collect Coins",
	Flag = "AutoCoins",
	CurrentValue = false,
	Callback = function(state)
		_G.AutoFarmEnabled = state
		if state then
			local autoFarmLoopId = {}
			_G.__AutoFarmLoopId = autoFarmLoopId
			
			task.spawn(function()
				while _G.AutoFarmEnabled and _G.__AutoFarmLoopId == autoFarmLoopId do
					task.wait(_G.CoinCollectCooldown or 0.05)
					if not _G.InRound or _G.BagFull then continue end
					
					local character = game.Players.LocalPlayer.Character
					local humanoidRootPart = character and character:FindFirstChild("HumanoidRootPart")
					local coinContainer = workspace:FindFirstChild("CoinContainer") or workspace:FindFirstChild("Coins")
					
					if humanoidRootPart and coinContainer then
						local closestCoin = nil
						local shortestDistance = math.huge
						
						for _, coin in ipairs(coinContainer:GetChildren()) do
							local handle = coin:FindFirstChild("Base") or coin:FindFirstChild("TouchInterest") or coin
							if handle and (handle:IsA("BasePart") or coin:IsA("BasePart")) then
								local targetPart = coin:IsA("BasePart") and coin or handle
								local distance = (humanoidRootPart.Position - targetPart.Position).Magnitude
								if distance < shortestDistance then
									shortestDistance = distance
									closestCoin = targetPart
								end
							end
						end
						
						if closestCoin then
							local targetPos = closestCoin.Position
							if _G.CollectCoinsUnderground then
								targetPos = Vector3.new(targetPos.X, targetPos.Y + (_G.UndergroundOffset or -15), targetPos.Z)
							end
							
							local distance = (humanoidRootPart.Position - targetPos).Magnitude
							local travelTime = distance / math.max(_G.AutoFarmSpeed or 16, 1)
							
							local tween = game:GetService("TweenService"):Create(humanoidRootPart, TweenInfo.new(travelTime, Enum.EasingStyle.Linear), {CFrame = CFrame.new(targetPos)})
							tween:Play()
							
							local elapsed = 0
							while tween.PlaybackState == Enum.PlaybackState.Playing and closestCoin.Parent and _G.AutoFarmEnabled do
								task.wait(0.05)
								elapsed = elapsed + 0.05
								if elapsed > (travelTime + 1) then break end
							end
							tween:Cancel()
						end
					end
				end
			end)
		end
	end
})

