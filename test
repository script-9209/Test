			function Section:CreateDropdown(Config)
				Config = Config or {}
				local name = Config.Name or "Dropdown"
				local flag = Config.Flag or name
				local options = Config.Options or {}
				local current = Config.CurrentOption

				local selected = ExodusHub.Flags[flag] ~= nil and ExodusHub.Flags[flag] or (type(current) == "table" and current[1] or current or options[1])
				ExodusHub.Flags[flag] = selected
				local callback = Config.Callback or function() end
				local isOpen = false

				local DropFrame = Instance.new("Frame")
				DropFrame.Size = UDim2.new(1, 0, 0, 38)
				DropFrame.ClipsDescendants = true
				DropFrame.ZIndex = 15
				DropFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
				DropFrame.BorderSizePixel = 0
				DropFrame.Parent = ItemsContainer

				apply3DEffect(DropFrame, Color3.fromRGB(30, 30, 30), Color3.fromRGB(60, 60, 60), Color3.fromRGB(15, 15, 15), 2)
				table.insert(sectionEntry.Items, { Frame = DropFrame, Text = string.lower(name) })

				local HeaderBtn = Instance.new("TextButton")
				HeaderBtn.Size = UDim2.new(1, 0, 0, 38)
				HeaderBtn.BackgroundTransparency = 1
				HeaderBtn.Text = "  " .. name .. ": " .. tostring(selected)
				HeaderBtn.Font = Enum.Font.FredokaOne
				HeaderBtn.TextSize = 14
				HeaderBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
				HeaderBtn.TextXAlignment = Enum.TextXAlignment.Left
				HeaderBtn.ZIndex = 16
				HeaderBtn.Parent = DropFrame

				local OptionList = Instance.new("Frame")
				OptionList.Size = UDim2.new(1, -12, 0, 0)
				OptionList.Position = UDim2.new(0, 6, 0, 42)
				OptionList.BackgroundTransparency = 1
				OptionList.ZIndex = 16
				OptionList.Parent = DropFrame

				local dropdownObj = {}
				function dropdownObj:Refresh(newOptions, newCurrent)
					options = newOptions or {}
					selected = ExodusHub.Flags[flag] ~= nil and ExodusHub.Flags[flag] or (type(newCurrent) == "table" and newCurrent[1] or newCurrent or options[1])
					HeaderBtn.Text = "  " .. name .. ": " .. tostring(selected)

					OptionList:ClearAllChildren()
					local Grid = Instance.new("UIGridLayout")
					Grid.CellSize = UDim2.new(0.5, -4, 0, 32)
					Grid.CellPadding = UDim2.new(0, 8, 0, 6)
					Grid.Parent = OptionList

					local rowsCount = math.ceil(#options / 2)
					OptionList.Size = UDim2.new(1, -12, 0, rowsCount * 36 + ((rowsCount - 1) * 6))

					for _, opt in ipairs(options) do
						local OptBtn = Instance.new("TextButton")
						OptBtn.Size = UDim2.new(1, 0, 1, 0)
						OptBtn.Text = "  " .. opt
						OptBtn.Font = Enum.Font.SourceSansBold
						OptBtn.TextSize = 14
						OptBtn.TextColor3 = Color3.fromRGB(240, 240, 240)
						OptBtn.AutoButtonColor = false
						OptBtn.ZIndex = 17
						OptBtn.Parent = OptionList

						apply3DEffect(OptBtn, Color3.fromRGB(45, 45, 45), Color3.fromRGB(80, 80, 80), Color3.fromRGB(20, 20, 20), 1)

						local RedMark = Instance.new("Frame")
						RedMark.Name = "RedMark"
						RedMark.Size = UDim2.new(0, 8, 0, 16)
						RedMark.Position = UDim2.new(1, -14, 0.5, -8)
						RedMark.BackgroundColor3 = ExodusHub.Themes[ExodusHub.CurrentTheme].Primary
						RedMark.BorderSizePixel = 0
						RedMark.Visible = (opt == selected)
						RedMark.ZIndex = 18
						RedMark.Parent = OptBtn

						OptBtn.Activated:Connect(function()
							selected = opt
							ExodusHub.Flags[flag] = selected
							HeaderBtn.Text = "  " .. name .. ": " .. selected
							isOpen = false
							DropFrame.Size = UDim2.new(1, 0, 0, 38)
							ExodusHub:SaveConfiguration()
							callback({selected})
						end)
					end
				end

				dropdownObj:Refresh(options, selected)

				HeaderBtn.Activated:Connect(function()
					isOpen = not isOpen
					if isOpen then
						DropFrame.Size = UDim2.new(1, 0, 0, 48 + OptionList.AbsoluteSize.Y)
					else
						DropFrame.Size = UDim2.new(1, 0, 0, 38)
					end
				end)

				return dropdownObj
			end

			function Section:CreateParagraph(Config)
				Config = Config or {}
				local container = Instance.new("Frame")
